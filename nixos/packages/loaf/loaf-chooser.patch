 namespace loaf {
 
+// Private interface used by the desktop portal wrapper. Normal Loaf windows
+// have no chooser output and retain their usual behaviour.
+QVariantMap LoafNative::chooser() const
+{
+    return m_chooser;
+}
+
+QString LoafNative::acceptChoice(const QStringList &paths)
+{
+    const auto options = chooser();
+    if (!options.value("enabled").toBool())
+        return tr("This window is not a file picker.");
+    const bool save = options.value("save").toBool();
+    const bool directory = options.value("directory").toBool();
+    if (paths.isEmpty() || ((!options.value("multiple").toBool() || save) && paths.size() != 1))
+        return tr("Select %1.").arg(directory ? tr("one folder") : tr("one file"));
+    QByteArray result;
+    for (const QString &path : paths) {
+        QFileInfo info(path);
+        if (!info.isAbsolute() || path.contains('\n') || path.contains('\r'))
+            return tr("Select a local path without line breaks.");
+        if (save) {
+            if (info.isDir() || !info.dir().exists() || info.fileName().isEmpty())
+                return tr("Choose a file name in an existing folder.");
+        } else if (!info.exists() || (directory ? !info.isDir() : !info.isFile())) {
+            return directory ? tr("Select folders only.") : tr("Select files only.");
+        }
+        result += QDir::cleanPath(path).toUtf8() + '\n';
+    }
+    QSaveFile output(m_chooserOutput);
+    if (!output.open(QIODevice::WriteOnly) || output.write(result) != result.size() || !output.commit())
+        return tr("Could not return the selection: %1").arg(output.errorString());
+    QCoreApplication::quit();
+    return {};
+}
