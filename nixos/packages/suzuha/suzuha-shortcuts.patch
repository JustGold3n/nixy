+
+// Only the visible menu handles shortcuts; hiding it also prevents key repeats.
+pub fn key_pressed(key: Key) {
+    if !Overlay::read().power_menu.shown {
+        return;
+    }
+    if key == Key::Escape {
+        Overlay::hide_power_menu();
+    } else if let Some(action) = shortcut(key) {
+        run(action.command);
+    }
+}
+
+fn shortcut(key: Key) -> Option<&'static Action> {
+    let Key::Character(letter) = key else { return None };
+    ACTIONS.iter().find(|action| action.shortcut == letter.to_ascii_lowercase())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn shortcuts_select_the_expected_commands() {
+        for (letter, command) in [
+            ('p', "systemctl poweroff"),
+            ('l', "loginctl lock-session"),
+            ('r', "systemctl reboot"),
+            ('s', "systemctl suspend"),
+            ('q', "niri msg action quit --skip-confirmation"),
+        ] {
+            assert_eq!(shortcut(Key::Character(letter)).unwrap().command, command);
+            assert_eq!(shortcut(Key::Character(letter.to_ascii_uppercase())).unwrap().command, command);
+        }
+        for key in [Key::Character('x'), Key::Enter, Key::Escape, Key::Other] {
+            assert!(shortcut(key).is_none());
+        }
+    }
+}
