+fn read_index_theme(theme: &str, roots: &[PathBuf]) -> String {
+    // A theme can span multiple roots. Steam installs icons in the user's
+    // hicolor directory without an index, relying on the system's index.theme.
+    roots
+        .iter()
+        .find_map(|root| fs::read_to_string(root.join(theme).join("index.theme")).ok())
+        .unwrap_or_default()
 }
 
