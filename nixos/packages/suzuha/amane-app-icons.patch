+fn read_theme_icon_folders(theme: &str, roots: &[PathBuf]) -> Vec<Vec<PathBuf>> {
+    let index_theme = read_index_theme(theme, roots);
+    let names = parse_icon_folder_names(&index_theme);
+
+    if names.is_empty() {
+        return Vec::new();
+    }
+
+    // Keep user roots ahead of system roots, using the same directory list
+    // everywhere, including roots that contain icons but no theme index.
+    roots
+        .iter()
+        .map(|root| {
+            names
+                .iter()
+                .map(|name| root.join(theme).join(name))
+                .collect()
+        })
+        .collect()
 }
 
