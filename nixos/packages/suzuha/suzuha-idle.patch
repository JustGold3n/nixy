 impl Bus {
+    // Always drain zbus streams: a full signal queue blocks replies on the
+    // shared connection. State services only need one pending refresh, since
+    // their next snapshot reads the complete current state.
+    pub(crate) fn property_changes(&self, prefix: &'static str) -> Receiver<()> {
+        let signals = self.signals("org.freedesktop.DBus.Properties", "PropertiesChanged");
+        let (wake, changes) = mpsc::sync_channel(1);
+        thread::spawn(move || {
+            for signal in signals {
+                if signal.path().starts_with(prefix) {
+                    match wake.try_send(()) {
+                        Ok(()) | Err(TrySendError::Full(())) => {}
+                        Err(TrySendError::Disconnected(())) => return,
+                    }
+                }
+            }
+        });
+        changes
+    }
