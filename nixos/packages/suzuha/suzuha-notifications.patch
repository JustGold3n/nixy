+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hovering_pauses_expiration() {
+        let mut overlay = Overlay::new();
+        let mut popups = Popups::new();
+        popups.update(&overlay, &[1]);
+        popups.list[0].slide = motion::spatial(0.0, 0);
+        overlay.hovered_popup = Some(1);
+        popups.last_frame = Instant::now() - TIMEOUT * 2;
+        assert!(popups.update(&overlay, &[1]).is_empty());
+        assert_eq!(popups.list[0].left, TIMEOUT);
+        assert!(!popups.list[0].leaving);
+
+        overlay.hovered_popup = None;
+        popups.last_frame = Instant::now() - TIMEOUT * 2;
+        popups.update(&overlay, &[1]);
+        assert!(popups.list[0].leaving);
+    }
+
+    #[test]
+    fn expiration_waits_for_exit_animation_and_is_reported_once() {
+        let overlay = Overlay::new();
+        let mut popups = Popups::new();
+        popups.update(&overlay, &[1]);
+        popups.list[0].leaving = true;
+        popups.list[0].slide = motion::spatial(0.5, 0);
+        assert!(popups.update(&overlay, &[1]).is_empty());
+
+        popups.list[0].slide = motion::spatial(1.0, 0);
+        assert_eq!(popups.update(&overlay, &[1]), vec![1]);
+        assert!(popups.list.is_empty());
+        assert!(popups.update(&overlay, &[1]).is_empty());
+    }
+
+    #[test]
+    fn manual_close_leaves_early_and_sender_close_does_not_expire_again() {
+        let mut overlay = Overlay::new();
+        let mut popups = Popups::new();
+        popups.update(&overlay, &[1, 2]);
+        popups.list[0].slide = motion::spatial(0.0, 0);
+        overlay.closed_popups.push(1);
+        popups.update(&overlay, &[1, 2]);
+        assert!(popups.list[0].leaving);
+        assert!(!popups.list[1].leaving);
+
+        popups.list[0].slide = motion::spatial(1.0, 0);
+        assert_eq!(popups.update(&overlay, &[1, 2]), vec![1]);
+        assert!(popups.update(&overlay, &[]).is_empty());
+        assert!(popups.list.is_empty());
+    }
+}
