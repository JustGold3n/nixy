+    // Never reuse a predictable shared /tmp path: it can be pre-created by
+    // another user. mkstemp creates a unique result file with mode 0600.
+    char *filename = strdup(PATH_PORTAL_BASE "-XXXXXX");
+    if (filename == NULL) {
+        return -1;
+    }
+    int fd = mkstemp(filename);
+    if (fd == -1) {
+        logprint(ERROR, "filechooser: could not create result file: %s", strerror(errno));
+        free(filename);
+        return -1;
+    }
+    if (close(fd) != 0) {
+        remove(filename);
+        free(filename);
+        return -1;
+    }
 
