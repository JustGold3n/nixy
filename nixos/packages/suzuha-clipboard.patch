+// The clipboard shares the launcher's search, keyboard handling and animations.
+pub fn clipboard_ipc(arguments: &[String]) -> String {
+    let command = arguments.first().map(String::as_str).unwrap_or("toggle");
+    let mut overlay = Overlay::write();
+    match command {
+        "hide" => {
+            if overlay.clipboard_mode {
+                overlay.launcher.hide();
+            }
+        }
+        "toggle" if overlay.launcher.shown && overlay.clipboard_mode => overlay.launcher.hide(),
+        "show" | "toggle" => {
+            show(&mut overlay);
+            overlay.clipboard_mode = true;
+            overlay.query.clear();
+            TextInput::set_text(INPUT, "");
+            clipboard::refresh();
+        }
+        _ => return String::from("Use clipboard show, hide or toggle"),
+    }
     String::from("ok")
 }
 
