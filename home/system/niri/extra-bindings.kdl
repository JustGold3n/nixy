// Navigation: arrow keys mirror the existing H/J/K/L shortcuts.
Mod+Left { focus-column-left; }
Mod+Down { focus-window-down; }
Mod+Up { focus-window-up; }
Mod+Right { focus-column-right; }
Mod+Ctrl+Left { move-column-left; }
Mod+Ctrl+Down { move-window-down; }
Mod+Ctrl+Up { move-window-up; }
Mod+Ctrl+Right { move-column-right; }
Mod+Shift+Left { focus-monitor-left; }
Mod+Shift+Down { focus-monitor-down; }
Mod+Shift+Up { focus-monitor-up; }
Mod+Shift+Right { focus-monitor-right; }
Mod+Ctrl+J { focus-monitor-down; }
Mod+Ctrl+K { focus-monitor-up; }
Mod+Ctrl+Shift+Left { move-column-to-monitor-left; }
Mod+Ctrl+Shift+Down { move-column-to-monitor-down; }
Mod+Ctrl+Shift+Up { move-column-to-monitor-up; }
Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
Mod+Alt+Shift+Left { move-window-to-monitor-left; }
Mod+Alt+Shift+Down { move-window-to-monitor-down; }
Mod+Alt+Shift+Up { move-window-to-monitor-up; }
Mod+Alt+Shift+Right { move-window-to-monitor-right; }
Mod+Alt+Ctrl+Shift+Left { move-workspace-to-monitor-left; }
Mod+Alt+Ctrl+Shift+Down { move-workspace-to-monitor-down; }
Mod+Alt+Ctrl+Shift+Up { move-workspace-to-monitor-up; }
Mod+Alt+Ctrl+Shift+Right { move-workspace-to-monitor-right; }

// Cross monitor/workspace edges without needing a separate switch.
Mod+Alt+Left { focus-column-or-monitor-left; }
Mod+Alt+Right { focus-column-or-monitor-right; }
Mod+Alt+Up { focus-window-or-monitor-up; }
Mod+Alt+Down { focus-window-or-monitor-down; }
Mod+Alt+Ctrl+Left { move-column-left-or-to-monitor-left; }
Mod+Alt+Ctrl+Right { move-column-right-or-to-monitor-right; }
Mod+Alt+Ctrl+Up { move-window-up-or-to-workspace-up; }
Mod+Alt+Ctrl+Down { move-window-down-or-to-workspace-down; }
Mod+Alt+H { focus-column-left-or-last; }
Mod+Alt+L { focus-column-right-or-first; }
Mod+Alt+J { focus-window-down-or-top; }
Mod+Alt+K { focus-window-up-or-bottom; }
Mod+Alt+Ctrl+Shift+H { focus-window-down-or-column-left; }
Mod+Alt+Ctrl+Shift+L { focus-window-down-or-column-right; }
Mod+Alt+Ctrl+Shift+U { focus-window-up-or-column-left; }
Mod+Alt+Ctrl+Shift+I { focus-window-up-or-column-right; }
Mod+Alt+Ctrl+Shift+J { focus-window-or-workspace-down; }
Mod+Alt+Ctrl+Shift+K { focus-window-or-workspace-up; }
Mod+Home { focus-column-first; }
Mod+End { focus-column-last; }
Mod+Ctrl+Home { move-column-to-first; }
Mod+Ctrl+End { move-column-to-last; }
Mod+Shift+Home { focus-window-top; }
Mod+Shift+End { focus-window-bottom; }
Mod+Backspace { focus-workspace-previous; }
Mod+Ctrl+Backspace { focus-window-previous; }

// Columns, stacking, tabs, floating windows, and sizing.
Mod+BracketLeft { consume-or-expel-window-left; }
Mod+BracketRight { consume-or-expel-window-right; }
Mod+Alt+BracketLeft { swap-window-left; }
Mod+Alt+BracketRight { swap-window-right; }
Mod+Ctrl+Comma { consume-window-into-column; }
Mod+Period { expel-window-from-column; }
Mod+W repeat=false { toggle-column-tabbed-display; }
Mod+Ctrl+W { set-column-display "normal"; }
Mod+Ctrl+Shift+W { set-column-display "tabbed"; }
Mod+Shift+C { center-column; }
Mod+Ctrl+C { center-visible-columns; }
Mod+Ctrl+Shift+C { center-window; }
Mod+M repeat=false { maximize-window-to-edges; }
Mod+Shift+M repeat=false { maximize-column; }
Mod+Ctrl+F { expand-column-to-available-width; }
Mod+Alt+F repeat=false { toggle-windowed-fullscreen; }
Mod+V repeat=false { toggle-window-floating; }
Mod+Shift+V repeat=false { switch-focus-between-floating-and-tiling; }
Mod+Ctrl+V { focus-floating; }
Mod+Ctrl+Shift+V { focus-tiling; }
Mod+Alt+V { move-window-to-floating; }
Mod+Alt+Shift+V { move-window-to-tiling; }
Mod+Alt+Ctrl+H { spawn "niri" "msg" "action" "move-floating-window" "--x=-40"; }
Mod+Alt+Ctrl+J { spawn "niri" "msg" "action" "move-floating-window" "--y=+40"; }
Mod+Alt+Ctrl+K { spawn "niri" "msg" "action" "move-floating-window" "--y=-40"; }
Mod+Alt+Ctrl+L { spawn "niri" "msg" "action" "move-floating-window" "--x=+40"; }
Mod+Shift+R { switch-preset-column-width-back; }
Mod+Ctrl+R { reset-window-height; }
Mod+Ctrl+Shift+R { switch-preset-window-height; }
Mod+Alt+R { switch-preset-window-width; }
Mod+Alt+Shift+R { switch-preset-window-width-back; }
Mod+Alt+Ctrl+R { switch-preset-window-height-back; }
Mod+Shift+Minus { set-window-height "-10%"; }
Mod+Shift+Equal { set-window-height "+10%"; }
Mod+Alt+Minus { set-window-width "-10%"; }
Mod+Alt+Equal { set-window-width "+10%"; }
Mod+Ctrl+O repeat=false { toggle-window-rule-opacity; }

// Workspace navigation and placement.
Mod+U { focus-workspace-down; }
Mod+I { focus-workspace-up; }
Mod+Ctrl+U { move-column-to-workspace-down; }
Mod+Ctrl+I { move-column-to-workspace-up; }
Mod+Shift+U { move-workspace-down; }
Mod+Shift+I { move-workspace-up; }
Mod+Alt+U { move-window-to-workspace-down; }
Mod+Alt+I { move-window-to-workspace-up; }
Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
Mod+Ctrl+Shift+Page_Down { move-workspace-down; }
Mod+Ctrl+Shift+Page_Up { move-workspace-up; }
Mod+Alt+Page_Down { move-window-to-workspace-down; }
Mod+Alt+Page_Up { move-window-to-workspace-up; }
Mod+Ctrl+Alt+Comma { move-window-to-monitor-previous; }
Mod+Ctrl+Alt+Period { move-window-to-monitor-next; }
Mod+Ctrl+Shift+Comma { move-column-to-monitor-previous; }
Mod+Ctrl+Shift+Period { move-column-to-monitor-next; }
Mod+Alt+Shift+Comma { move-workspace-to-monitor-previous; }
Mod+Alt+Shift+Period { move-workspace-to-monitor-next; }

// Mouse wheel: vertical switches workspaces; horizontal switches columns.
Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
Mod+WheelScrollLeft { focus-column-left; }
Mod+WheelScrollRight { focus-column-right; }
Mod+Ctrl+WheelScrollLeft { move-column-left; }
Mod+Ctrl+WheelScrollRight { move-column-right; }
Mod+Shift+WheelScrollUp { focus-column-left; }
Mod+Shift+WheelScrollDown { focus-column-right; }
Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }
Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }

// Overview, screenshots, screencast targets, and session controls.
Mod+O repeat=false { toggle-overview; }
Mod+Alt+O { open-overview; }
Mod+Alt+Shift+O { close-overview; }
Ctrl+Print { screenshot-screen; }
Alt+Print { screenshot-window; }
Mod+F9 { set-dynamic-cast-window; }
Mod+Shift+F9 { set-dynamic-cast-monitor; }
Mod+Ctrl+F9 { clear-dynamic-cast-target; }
Mod+Ctrl+Escape allow-inhibiting=false repeat=false { toggle-keyboard-shortcuts-inhibit; }
Mod+Ctrl+Alt+P { power-off-monitors; }
Mod+Ctrl+Alt+Shift+P { power-on-monitors; }
Mod+Ctrl+Shift+F5 { spawn "niri" "msg" "action" "load-config-file"; }
Mod+F6 { switch-layout "next"; }
Mod+Shift+F6 { switch-layout "prev"; }
Ctrl+Alt+Delete repeat=false { quit; }
